pragma solidity ^0.8.0;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract WhitelistTokenLimited is ERC20, Ownable {
    mapping(address => bool) public isWhitelisted;
    mapping(address => uint256) public transferCount;
    uint256 public maxTransfers = 3;

    constructor() ERC20("WhitelistToken", "WLT") {
        _mint(msg.sender, 1_000_000 * 10 ** decimals());
        isWhitelisted[msg.sender] = true;
    }

    function setWhitelist(address user, bool status) external onlyOwner {
        isWhitelisted[user] = status;
    }

    function setMaxTransfers(uint256 _max) external onlyOwner {
        maxTransfers = _max;
    }

    function resetTransferCount(address user) external onlyOwner {
        transferCount[user] = 0;
    }

    function _beforeTokenTransfer(address from, address to, uint256 amount) internal override {
        // Разрешаем mint и burn
        if (from != address(0) && to != address(0)) {
            require(isWhitelisted[from], "Sender not whitelisted");
            require(transferCount[from] < maxTransfers, "Transfer limit exceeded");
            transferCount[from]++;
        }
        super._beforeTokenTransfer(from, to, amount);
    }
}
